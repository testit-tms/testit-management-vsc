{
  "name": "testit-management",
  "displayName": "Test IT Management",
  "description": "",
  "version": "0.3.0-TMS-5.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/testit-tms/testit-management-vsc"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "views": {
      "testit-management": [
        {
          "id": "testitManagement",
          "name": "Test IT Management",
          "icon": "icons/tool_window/toolWindow.svg",
          "contextualTitle": "Test IT Management"
        }
      ]
    },
    "commands": [
      {
          "command": "testitManagement.refreshEntry",
          "title": "Refresh Test IT Data",
          "icon": "$(refresh)"
      },
      {
          "command": "testitManagement.openSettings",
          "title": "Test IT Settings",
          "icon": "$(wrench)"
      },
      {
        "command": "testitManagement.copyItem",
        "title": "Copy"
      },
      {
        "command": "testitManagement.replace",
        "title": "Replace"
      },
      {
        "command": "testitManagement.replaceAll",
        "title": "Replace All"
      },
      {
        "command": "testitManagement.parsingAllure",
        "title": "Search Allure Methods",
        "icon": "icons/search_allure/search_allure_dark.svg"
      },
      {
        "command": "testitManagement.itemClick",
        "title": "Click"
      }
    ],
    "menus": {
      "view/title": [
          {
              "command": "testitManagement.refreshEntry",
              "when": "view == testitManagement",
              "group": "navigation"
          },
          {
              "command": "testitManagement.openSettings",
              "when": "view == testitManagement",
              "group": "navigation"
          },
          {
            "command": "testitManagement.parsingAllure",
            "when": "view == testitManagement",
            "group": "navigation"
          }
      ],
      "view/item/context": [
        {
          "command": "testitManagement.copyItem",
          "when": "view == testitManagement && viewItem == TestCases || CheckLists || SharedSteps"
        },
        {
          "command": "testitManagement.replace",
          "when": "view == testitManagement && viewItem == file"
        },
        {
          "command": "testitManagement.replaceAll",
          "when": "view == testitManagement && viewItem == folder"
        }
      ]
    },
    "configuration": {
			"type": "object",
			"title": "Test IT",
			"properties": {
        "testitManagement.url": {
					"type": "string"
				},
        "testitManagement.token": {
					"type": "string"
				},
        "testitManagement.projectId": {
					"type": "string"
				},
        "testitManagement.framework": {
					"type": "string",
					"default": "junit",
					"enum": [
            "junit",
            "behave",
            "nose",
            "pytest",
            "robotframework",
            "mstest",
            "nunit",
            "xunit",
            "specflow",
            "codeceptjs",
            "cucumber",
            "jest",
            "mocha",
            "playwright",
            "testcafe"
					]
				}
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "testit-management",
          "title": "Test IT Management",
          "icon": "icons/tool_window/toolWindow.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production"
  },
  "dependencies": {
    "testit-api-client": "7.3.1-TMS-5.8"
  },
  "devDependencies": {
    "@types/node": "^20.2.4",
    "@types/request": "^2.48.8",
    "@types/vscode": "^1.42.0",
    "esbuild": "^0.27.2",
    "tslint": "^5.12.1",
    "typescript": "^5.9.0"
  }
}
